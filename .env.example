# tablet.ai Environment Configuration

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# OpenAI Vision API (Extraction Engine - GPT-4o / GPT-4o-mini)
# Get your API key from OpenAI Platform: https://platform.openai.com/api-keys
OPENAI_API_KEY=""
OPENAI_VISION_MODEL="gpt-4o-mini"

# Optional Gemini Vision API
GEMINI_API_KEY=""

# PostgreSQL Database (Supabase or local PostgreSQL 16)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tablet_ai"

# Redis (for BullMQ delayed reminders and state caching)
REDIS_URL="redis://localhost:6379"

# Telegram Bot Integration
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME="TabletAiReminderBot"
TELEGRAM_WEBHOOK_SECRET=""

# Push Notifications (Firebase FCM)
NEXT_PUBLIC_FIREBASE_API_KEY=""
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
