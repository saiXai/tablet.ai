# tablet.ai Environment Configuration

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Gemini Multimodal Vision API (Required for receipt/bill parsing)
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=""

# PostgreSQL Database (Supabase or local PostgreSQL 16)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tablet_ai"

# Redis (for BullMQ delayed reminders and state caching)
REDIS_URL="redis://localhost:6379"

# Telegram Bot Integration
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME="TabletAiReminderBot"
TELEGRAM_WEBHOOK_SECRET=""

# Push Notifications (Firebase FCM)
NEXT_PUBLIC_FIREBASE_API_KEY=""
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
